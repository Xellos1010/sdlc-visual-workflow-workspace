{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flagship-foundry.local/schemas/glossary.schema.json",
  "title": "Engineering Glossary",
  "description": "Machine-readable glossary of engineering terms with phase mappings",
  "type": "object",
  "required": ["version", "source", "categories"],
  "properties": {
    "version": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "terms"],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "terms": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["term", "definition"],
              "properties": {
                "term": {
                  "type": "string"
                },
                "definition": {
                  "type": "string"
                },
                "relatedTerms": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "applicablePhases": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
