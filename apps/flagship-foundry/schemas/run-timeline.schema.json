{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flagship-foundry.local/schemas/run-timeline.schema.json",
  "title": "RunTimeline",
  "description": "Extends the run structure with per-task timeline fields, verification results, and evidence artifacts.",
  "type": "object",
  "required": ["id", "planId", "status", "tasks"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique run identifier"
    },
    "planId": {
      "type": "string",
      "description": "ID of the plan that produced this run"
    },
    "ecosystemId": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["ready", "running", "paused", "stopped", "completed", "failed"]
    },
    "mode": {
      "type": "string"
    },
    "adapterId": {
      "type": "string"
    },
    "isolation": {
      "$ref": "#/$defs/RunIsolation"
    },
    "rollback": {
      "$ref": "#/$defs/RunRollback"
    },
    "timeline": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RunTimelineEvent"
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp when the run transitioned to running"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp when the run reached completed status"
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RunTask"
      }
    },
    "agentSessions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "$defs": {
    "VerificationResult": {
      "type": "object",
      "required": ["command", "exitCode", "timestamp"],
      "properties": {
        "command": {
          "type": "string",
          "description": "The shell command that was executed"
        },
        "exitCode": {
          "type": "integer",
          "description": "Process exit code; 0 indicates success"
        },
        "output": {
          "type": "string",
          "description": "Truncated stdout/stderr output"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp when the command ran"
        }
      }
    },
    "RunTask": {
      "type": "object",
      "required": ["id", "status"],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "phase": {
          "type": "string",
          "description": "Phase token (inspect, design, implement, verify, document, learn)"
        },
        "phaseToken": {
          "type": "string"
        },
        "sequence": {
          "type": "integer"
        },
        "projectId": {
          "type": "string"
        },
        "projectPlanId": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["queued", "running", "paused", "stopped", "completed", "failed"]
        },
        "personaIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "acceptanceCriteria": {
          "type": "array",
          "items": { "type": "string" }
        },
        "commands": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Verification commands defined in the plan"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp when the task transitioned to running"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp when the task reached completed or failed status"
        },
        "durationMs": {
          "type": "integer",
          "description": "Wall-clock duration in milliseconds (completedAt - startedAt)"
        },
        "verificationResults": {
          "type": "array",
          "items": { "$ref": "#/$defs/VerificationResult" },
          "description": "Results of verification commands run during this task"
        },
        "evidenceArtifacts": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "required": ["path"],
                "properties": {
                  "type": { "type": "string" },
                  "path": { "type": "string" }
                }
              }
            ]
          },
          "description": "File paths of evidence artifacts produced by this task"
        },
        "fixMemoryRef": {
          "type": "string",
          "description": "Pointer to a fix-memory record linked to this task run."
        },
        "correlation": {
          "$ref": "#/$defs/RunTaskCorrelation"
        },
        "telemetryReferences": {
          "$ref": "#/$defs/TelemetryReferenceCollection"
        }
      }
    },
    "RunTaskCorrelation": {
      "type": "object",
      "required": ["runId", "taskId"],
      "properties": {
        "runId": { "type": "string" },
        "taskId": { "type": "string" },
        "planId": { "type": "string" },
        "ecosystemId": { "type": "string" },
        "adapterId": { "type": "string" }
      }
    },
    "TelemetryReference": {
      "type": "object",
      "required": ["ref", "timestamp", "correlation"],
      "properties": {
        "ref": { "type": "string" },
        "kind": { "type": "string" },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "notes": { "type": "string" },
        "correlation": { "$ref": "#/$defs/RunTaskCorrelation" }
      }
    },
    "TelemetryReferenceCollection": {
      "type": "object",
      "properties": {
        "before": {
          "type": "array",
          "items": { "$ref": "#/$defs/TelemetryReference" }
        },
        "after": {
          "type": "array",
          "items": { "$ref": "#/$defs/TelemetryReference" }
        }
      }
    },
    "RunIsolation": {
      "type": "object",
      "required": ["mode", "workspaceRoot", "defaultWritePolicy", "allowExternalWritesByDefault"],
      "properties": {
        "mode": { "type": "string" },
        "workspaceRoot": { "type": "string" },
        "defaultWritePolicy": { "type": "string" },
        "allowExternalWritesByDefault": { "type": "boolean" }
      }
    },
    "RunRollback": {
      "type": "object",
      "required": ["boundary"],
      "properties": {
        "boundary": { "type": "string" },
        "pausePreservesEvidence": { "type": "boolean" },
        "stopPreservesEvidence": { "type": "boolean" }
      }
    },
    "RunTimelineEvent": {
      "type": "object",
      "required": ["type", "timestamp"],
      "properties": {
        "type": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "details": { "type": "object" }
      }
    }
  }
}
