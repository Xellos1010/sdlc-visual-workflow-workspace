{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flagship-foundry.local/schemas/agent-work-order.schema.json",
  "title": "Agent Work Order",
  "type": "object",
  "required": [
    "id",
    "projectId",
    "phase",
    "title",
    "personaIds",
    "acceptanceCriteria"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "projectId": {
      "type": "string"
    },
    "phase": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "personaIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "paused",
        "done",
        "stopped"
      ]
    }
  }
}
