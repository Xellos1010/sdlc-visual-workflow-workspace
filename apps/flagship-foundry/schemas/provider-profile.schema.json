{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flagship.local/schemas/provider-profile.schema.json",
  "title": "Provider Profile",
  "type": "object",
  "required": [
    "providerId",
    "displayName",
    "protocol",
    "transport"
  ],
  "properties": {
    "providerId": {
      "type": "string"
    },
    "displayName": {
      "type": "string"
    },
    "protocol": {
      "type": "string"
    },
    "transport": {
      "type": "string"
    },
    "suitableForCritical": {
      "type": "boolean"
    },
    "riskFit": {
      "type": "string"
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
