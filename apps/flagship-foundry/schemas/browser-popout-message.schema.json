{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flagship-foundry.local/schemas/browser-popout-message.schema.json",
  "title": "Browser Pop-out Message",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "type",
        "protocolVersion",
        "token",
        "clientId",
        "timestamp"
      ],
      "properties": {
        "type": {
          "const": "handshake"
        },
        "protocolVersion": {
          "type": "string",
          "minLength": 1
        },
        "token": {
          "type": "string",
          "minLength": 1
        },
        "clientId": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "type",
        "requestId",
        "action",
        "timestamp"
      ],
      "properties": {
        "type": {
          "const": "command"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "payload": {
          "description": "Optional command payload relayed from the browser.",
          "type": [
            "object",
            "array",
            "string",
            "number",
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "type",
        "requestId",
        "status",
        "timestamp"
      ],
      "properties": {
        "type": {
          "const": "response"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "error"
          ]
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "result": {
          "type": "object",
          "required": [
            "summary"
          ],
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "details": {},
            "metadata": {}
          },
          "additionalProperties": false
        },
        "error": {
          "$ref": "#/$defs/error"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "ok"
              }
            }
          },
          "then": {
            "required": [
              "result"
            ],
            "not": {
              "required": [
                "error"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "error"
              }
            }
          },
          "then": {
            "required": [
              "error"
            ],
            "not": {
              "required": [
                "result"
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "type",
        "timestamp",
        "state"
      ],
      "properties": {
        "type": {
          "const": "state-update"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "state": {
          "type": "object",
          "description": "Serialized overlay state JSON"
        }
      },
      "additionalProperties": false
    }
  ],
  "$defs": {
    "error": {
      "type": "object",
      "required": [
        "message"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "stack": {
          "type": "string"
        },
        "code": {
          "type": [
            "string",
            "number"
          ]
        },
        "details": {}
      },
      "additionalProperties": false
    }
  }
}
