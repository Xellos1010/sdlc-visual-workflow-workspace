{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flagship-foundry.local/schemas/saved-layout.schema.json",
  "title": "Saved Layout",
  "type": "object",
  "required": [
    "layoutId",
    "stateKind",
    "userScope",
    "title",
    "role",
    "status",
    "version",
    "reversible",
    "centerCanvas",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "layoutId": {
      "type": "string",
      "minLength": 1
    },
    "stateKind": {
      "type": "string",
      "enum": [
        "declared",
        "observed"
      ]
    },
    "userScope": {
      "type": "object",
      "required": [
        "scopeKind",
        "userId"
      ],
      "properties": {
        "scopeKind": {
          "type": "string",
          "enum": [
            "user",
            "workspace-user",
            "profile"
          ]
        },
        "userId": {
          "type": "string",
          "minLength": 1
        },
        "workspaceTargetId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "enum": [
        "architect",
        "planner",
        "operator",
        "investigator",
        "custom"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "saved",
        "archived",
        "superseded"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "reversible": {
      "type": "boolean"
    },
    "previousLayoutId": {
      "type": [
        "string",
        "null"
      ]
    },
    "focusSummary": {
      "type": [
        "string",
        "null"
      ]
    },
    "selectedObjectRef": {
      "anyOf": [
        {
          "$ref": "#/$defs/objectRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "topBar": {
      "$ref": "#/$defs/stringList"
    },
    "leftRail": {
      "$ref": "#/$defs/stringList"
    },
    "centerCanvas": {
      "type": "object",
      "required": [
        "activeViewId",
        "availableViewIds"
      ],
      "properties": {
        "activeViewId": {
          "$ref": "#/$defs/peerViewId"
        },
        "availableViewIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/peerViewId"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "compareViewId": {
          "anyOf": [
            {
              "$ref": "#/$defs/peerViewId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "rightInspector": {
      "$ref": "#/$defs/stringList"
    },
    "bottomUtility": {
      "$ref": "#/$defs/stringList"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "peerViewId": {
      "type": "string",
      "enum": [
        "map",
        "board",
        "timeline",
        "diff",
        "inspector",
        "evidence",
        "chat",
        "pseudocode",
        "session-board"
      ]
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "objectRef": {
      "type": "object",
      "required": [
        "objectType",
        "objectId"
      ],
      "properties": {
        "objectType": {
          "type": "string",
          "minLength": 1
        },
        "objectId": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
