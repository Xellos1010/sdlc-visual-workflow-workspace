{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flagship-foundry.local/schemas/context-cart.schema.json",
  "title": "Context Cart",
  "type": "object",
  "required": [
    "cartId",
    "workspaceTargetId",
    "title",
    "status",
    "items",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "cartId": {
      "type": "string"
    },
    "workspaceTargetId": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "objective": {
      "type": [
        "string",
        "null"
      ]
    },
    "summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ready",
        "archived"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "itemId",
          "kind",
          "label",
          "authority",
          "selectedAt"
        ],
        "properties": {
          "itemId": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "file",
              "directory",
              "graph-node",
              "artifact",
              "diagram",
              "note",
              "external-context"
            ]
          },
          "label": {
            "type": "string"
          },
          "authority": {
            "type": "string",
            "enum": [
              "workspace",
              "foundry-state",
              "manual",
              "external"
            ]
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "nodeId": {
            "type": [
              "string",
              "null"
            ]
          },
          "artifactPath": {
            "type": [
              "string",
              "null"
            ]
          },
          "sourceUri": {
            "type": [
              "string",
              "null"
            ]
          },
          "content": {
            "type": [
              "string",
              "null"
            ]
          },
          "excerpt": {
            "type": [
              "string",
              "null"
            ]
          },
          "rationale": {
            "type": [
              "string",
              "null"
            ]
          },
          "metadata": {
            "type": "object"
          },
          "selectedBy": {
            "type": [
              "string",
              "null"
            ]
          },
          "selectedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
