{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flagship-foundry.local/schemas/phase-lifecycle.schema.json",
  "title": "Phase Lifecycle Ontology",
  "description": "Machine-readable catalog of all SDLC lifecycle phases with principles, gates, agents, and artifact requirements",
  "type": "object",
  "required": ["version", "lifecycleModel", "loops", "phases"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "lifecycleModel": {
      "type": "string"
    },
    "loops": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "phases", "description"],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "phases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "phases": {
      "type": "array",
      "minItems": 11,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "order",
          "loop",
          "objective",
          "primaryAgent",
          "supportingAgents",
          "principles",
          "guardrailPacks",
          "definitionOfReady",
          "definitionOfDone",
          "requiredArtifacts",
          "visualizationTypes",
          "glossaryCategories",
          "skills",
          "nextPhase"
        ],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "discover",
              "define",
              "visualize",
              "architect",
              "plan",
              "implement",
              "verify",
              "release",
              "operate",
              "diagnose",
              "improve"
            ]
          },
          "name": {
            "type": "string"
          },
          "order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 11
          },
          "loop": {
            "type": "string"
          },
          "objective": {
            "type": "string"
          },
          "primaryAgent": {
            "type": "string"
          },
          "supportingAgents": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "principles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "guardrailPacks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "definitionOfReady": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "definitionOfDone": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "requiredArtifacts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "visualizationTypes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "glossaryCategories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "nextPhase": {
            "type": ["string", "null"]
          }
        }
      }
    }
  }
}
