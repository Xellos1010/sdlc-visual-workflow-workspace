      }
    },
    "knowledgePackIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "frameworkIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "platformIds": {
      "type": "array",
