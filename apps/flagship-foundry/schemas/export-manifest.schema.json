{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flagship-foundry.local/schemas/export-manifest.schema.json",
  "title": "Export Manifest",
  "type": "object",
  "required": ["packetId", "ecosystemId", "exportedAt", "artifacts", "provenance", "checksums"],
  "properties": {
    "packetId": { "type": "string" },
    "ecosystemId": { "type": "string" },
    "exportedAt": { "type": "string", "format": "date-time" },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifactId", "path", "schemaRef"],
        "properties": {
          "artifactId": { "type": "string" },
          "path": { "type": "string" },
          "schemaRef": { "type": "string" },
          "artifactType": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object",
      "required": ["sourceAgent", "sessionId"],
      "properties": {
        "sourceAgent": { "type": "string" },
        "sessionId": { "type": "string" },
        "sourceRunId": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "checksums": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

