{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flagship.local/schemas/telemetry-event.schema.json",
  "title": "Telemetry Event",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "timestamp",
    "systemId"
  ],
  "properties": {
    "eventId": {
      "type": "string"
    },
    "eventType": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "systemId": {
      "type": "string"
    },
    "componentId": {
      "type": "string"
    },
    "severity": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    },
    "correlationId": {
      "type": "string"
    }
  }
}
