{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flagship-foundry.local/schemas/pipeline-definition.schema.json",
  "title": "Pipeline Definition",
  "type": "object",
  "required": ["pipelineId", "ecosystemId", "title", "stages", "defaultFailurePolicy", "createdAt"],
  "properties": {
    "pipelineId": { "type": "string" },
    "ecosystemId": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": ["string", "null"] },
    "defaultFailurePolicy": { "type": "string", "enum": ["halt", "skip", "retry"] },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "stageId",
          "order",
          "adapterId",
          "agentRole",
          "workOrderRef",
          "tokenBudget",
          "failurePolicy"
        ],
        "properties": {
          "stageId": { "type": "string" },
          "order": { "type": "integer", "minimum": 0 },
          "adapterId": { "type": "string" },
          "agentRole": { "type": "string" },
          "workOrderRef": { "type": "string" },
          "tokenBudget": { "type": "integer", "minimum": 1 },
          "failurePolicy": { "type": "string", "enum": ["halt", "skip", "retry"] },
          "retryLimit": { "type": ["integer", "null"], "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}

