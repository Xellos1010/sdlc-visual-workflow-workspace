{
  "guardrailPackId": "guardrail:aws-serverless",
  "scope": "cloud",
  "cloud": "AWS Serverless",
  "rules": [
    "treat IAM, retries, idempotency, and observability as core design surfaces",
    "define failure handling for every async trigger"
  ],
  "antiPatterns": [
    "broad IAM permissions",
    "non-idempotent retry paths",
    "missing dead-letter handling"
  ],
  "requiredChecks": [
    "iam-review",
    "retry-review",
    "observability-review"
  ],
  "escalationConditions": [
    "permission expansion",
    "new async integration"
  ]
}
