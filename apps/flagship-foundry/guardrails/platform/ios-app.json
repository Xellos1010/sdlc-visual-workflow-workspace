{
  "guardrailPackId": "guardrail:ios-app",
  "scope": "platform",
  "platform": "iOS",
  "rules": [
    "treat app state transitions and privacy permissions as explicit contracts",
    "prefer minimal entitlements"
  ],
  "antiPatterns": [
    "silent entitlement expansion",
    "background assumptions without review"
  ],
  "requiredChecks": [
    "entitlement-review",
    "privacy-review",
    "device-smoke"
  ],
  "escalationConditions": [
    "new entitlement",
    "privacy-sensitive data path"
  ]
}
