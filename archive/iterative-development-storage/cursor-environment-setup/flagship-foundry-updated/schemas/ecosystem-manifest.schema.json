{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flagship-foundry.local/schemas/ecosystem-manifest.schema.json",
  "title": "Ecosystem Manifest",
  "type": "object",
  "required": [
    "id",
    "name",
    "topology",
    "projects",
    "systems",
    "frameworks",
    "platforms"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "topology": {
      "type": "object"
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "systems": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "frameworks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "ruleFiles": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "existingVisualizations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "taskStates": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
