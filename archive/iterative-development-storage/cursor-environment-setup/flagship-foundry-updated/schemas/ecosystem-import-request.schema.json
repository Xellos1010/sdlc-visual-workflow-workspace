{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flagship-foundry.local/schemas/ecosystem-import-request.schema.json",
  "title": "Ecosystem Import Request",
  "type": "object",
  "required": [
    "source"
  ],
  "properties": {
    "ecosystemId": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "filesystem",
            "export-bundle"
          ]
        },
        "workspaceRoot": {
          "type": "string"
        },
        "codeExportPath": {
          "type": "string"
        },
        "configExportPath": {
          "type": "string"
        },
        "rulesExportPath": {
          "type": "string"
        },
        "chromeDocsPath": {
          "type": "string"
        }
      }
    }
  }
}
