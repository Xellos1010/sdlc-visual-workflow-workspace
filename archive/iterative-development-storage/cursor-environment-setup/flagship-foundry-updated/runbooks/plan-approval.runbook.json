{
  "$schema": "../schemas/runbook.schema.json",
  "id": "runbook:plan-approval",
  "name": "Plan Approval",
  "purpose": "Control whether draft plans require manual approval or may proceed automatically under policy.",
  "triggers": [
    "plan draft created",
    "policy toggle changed"
  ],
  "phases": [
    {
      "id": "review",
      "personaId": "persona:plan-approval-governor",
      "steps": [
        "inspect blast radius",
        "inspect risk and approvals",
        "inspect auto-start behavior"
      ]
    },
    {
      "id": "decide",
      "personaId": "persona:plan-approval-governor",
      "steps": [
        "approve or reject",
        "capture rationale",
        "set auto-start or manual start"
      ]
    }
  ],
  "handoffArtifacts": [
    "approval record",
    "plan state change",
    "audit note"
  ]
}
