{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flagship.local/schemas/fix-memory.schema.json",
  "title": "Fix Memory",
  "type": "object",
  "required": [
    "fixId",
    "problemSummary",
    "environment",
    "solutionSummary",
    "designParadigm",
    "evidenceRefs",
    "reusablePatterns"
  ],
  "properties": {
    "fixId": {
      "type": "string"
    },
    "problemSummary": {
      "type": "string"
    },
    "environment": {
      "type": "object"
    },
    "symptoms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rootCauseHypotheses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validatedRootCause": {
      "type": "string"
    },
    "solutionSummary": {
      "type": "string"
    },
    "designParadigm": {
      "type": "string"
    },
    "relatedPrinciples": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reusablePatterns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preventionRules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trainingLabel": {
      "type": "string"
    }
  }
}
