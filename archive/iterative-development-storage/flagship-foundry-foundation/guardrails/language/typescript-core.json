{
  "guardrailPackId": "guardrail:typescript-core",
  "scope": "language",
  "language": "TypeScript",
  "rules": [
    "prefer explicit types at contract boundaries",
    "keep schema-driven payload validation at ingress",
    "do not widen public types without version review"
  ],
  "antiPatterns": [
    "any leaking across service boundaries",
    "runtime-only assumptions for external payloads",
    "silent enum expansion"
  ],
  "requiredChecks": [
    "typecheck",
    "schema-validation",
    "targeted-tests"
  ],
  "escalationConditions": [
    "public API contract changes",
    "unsafe any in critical path"
  ]
}
