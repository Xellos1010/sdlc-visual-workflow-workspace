{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flagship.local/schemas/evidence-bundle.schema.json",
  "title": "Evidence Bundle",
  "type": "object",
  "required": [
    "evidenceId",
    "workOrderId",
    "evidenceType",
    "summary",
    "artifacts",
    "verdict"
  ],
  "properties": {
    "evidenceId": {
      "type": "string"
    },
    "workOrderId": {
      "type": "string"
    },
    "evidenceType": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metrics": {
      "type": "object"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "mixed",
        "unknown"
      ]
    }
  }
}
