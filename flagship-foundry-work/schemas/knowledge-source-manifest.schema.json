{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knowledge Source Manifest",
  "type": "object",
  "required": [
    "knowledgeBaseId",
    "name",
    "sources"
  ],
  "properties": {
    "knowledgeBaseId": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "markdown",
              "combined-markdown",
              "text-bundle",
              "javascript-source",
              "plain-text"
            ]
          },
          "path": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "metadata": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
