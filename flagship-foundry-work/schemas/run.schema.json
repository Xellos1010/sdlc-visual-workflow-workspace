{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flagship-foundry.local/schemas/run.schema.json",
  "title": "Run",
  "type": "object",
  "required": [
    "id",
    "planId",
    "status",
    "tasks",
    "mode",
    "adapterId"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "planId": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["ready", "running", "paused", "stopped", "completed", "failed"]
    },
    "mode": {
      "type": "string"
    },
    "adapterId": {
      "type": "string"
    },
    "isolation": {
      "type": "object",
      "required": ["mode", "workspaceRoot", "defaultWritePolicy", "allowExternalWritesByDefault"],
      "properties": {
        "mode": { "type": "string" },
        "workspaceRoot": { "type": "string" },
        "defaultWritePolicy": { "type": "string" },
        "allowExternalWritesByDefault": { "type": "boolean" }
      }
    },
    "rollback": {
      "type": "object",
      "required": ["boundary"],
      "properties": {
        "boundary": { "type": "string" },
        "pausePreservesEvidence": { "type": "boolean" },
        "stopPreservesEvidence": { "type": "boolean" }
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "timestamp"],
        "properties": {
          "type": { "type": "string" },
          "timestamp": { "type": "string", "format": "date-time" },
          "details": { "type": "object" }
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "agentSessions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
