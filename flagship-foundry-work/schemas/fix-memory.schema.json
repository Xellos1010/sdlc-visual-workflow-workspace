{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flagship-foundry.local/schemas/fix-memory.schema.json",
  "title": "Fix Memory Record",
  "type": "object",
  "required": [
    "problem",
    "environment",
    "solution",
    "designParadigm"
  ],
  "properties": {
    "problem": {
      "type": "string"
    },
    "environment": {
      "type": "string"
    },
    "solution": {
      "type": "string"
    },
    "designParadigm": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preventiveChecks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
