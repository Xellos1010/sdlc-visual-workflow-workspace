{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Flagship Foundry \u2014 Systems Architect Expected Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "impactStatement",
    "optionsAndTradeoffs",
    "recommendedDecomposition",
    "acceptanceCriteria",
    "riskRegister"
  ],
  "properties": {
    "impactStatement": {
      "type": "string"
    },
    "optionsAndTradeoffs": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "option",
          "pros",
          "cons"
        ],
        "properties": {
          "option": {
            "type": "string"
          },
          "pros": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "recommendedDecomposition": {
      "type": "object",
      "required": [
        "approach",
        "rationale"
      ],
      "properties": {
        "approach": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "affectedContracts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "diagrams": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "riskRegister": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "risk",
          "severity",
          "mitigation"
        ],
        "properties": {
          "risk": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "INFO",
              "LOW",
              "MEDIUM",
              "HIGH",
              "CRITICAL"
            ]
          },
          "mitigation": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  }
}