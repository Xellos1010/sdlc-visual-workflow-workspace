{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Flagship Foundry \u2014 Verifier Expected Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "overallVerdict",
    "criteriaBreakdown",
    "evidenceReferences",
    "recommendations"
  ],
  "properties": {
    "overallVerdict": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "MIXED",
        "INSUFFICIENT_EVIDENCE"
      ]
    },
    "criteriaBreakdown": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "criterion",
          "verdict"
        ],
        "properties": {
          "criterion": {
            "type": "string"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "MIXED",
              "INSUFFICIENT_EVIDENCE"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "evidenceReferences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missingProofList": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "regressionCheck": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "continuityUpdate": {
      "type": "object"
    }
  }
}