      "type": "string"
    },
    "iterations": {
      "type": "integer"
    },
    "elapsed": {
      "type": "string"
    },
    "ciAttemptDetails": {
      "type": "object"
    },
    "selfHealingDetails": {
      "type": "object"
    },
    "fixInformation": {
      "type": "object"
    },
    "hints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}