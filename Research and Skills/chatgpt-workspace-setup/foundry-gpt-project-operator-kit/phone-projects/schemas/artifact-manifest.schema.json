{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Artifact Manifest",
  "type": "object",
  "required": [
    "bundleName",
    "projectName",
    "phaseId",
    "artifacts"
  ],
  "properties": {
    "bundleName": {
      "type": "string"
    },
    "projectName": {
      "type": "string"
    },
    "phaseId": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "artifactType",
          "purpose"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "artifactType": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          }
        }
      }
    }
  }
}