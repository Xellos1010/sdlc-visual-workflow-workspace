{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "file_lock_plan",
  "type": "object",
  "required": ["schema_version", "lock_requests", "blocked_files", "compatible_parallel_work", "release_instructions", "next_skill_handoff"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"type": "string"},
    "run_id": {"type": "string"},
    "project": {"type": "string"},
    "repository": {"type": "string"},
    "lifecycle_stage": {"type": "string"},
    "task_status": {"type": "string"},
    "source_inputs": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "blocked_actions": {"type": "array", "items": {"type": "string"}},
    "allowed_actions": {"type": "array", "items": {"type": "string"}},
    "blocking_gaps": {"type": "array", "items": {"type": "string"}},
    "next_skill_handoff": {"type": "object", "additionalProperties": true}
  }
}
