{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "test_strategy",
  "type": "object",
  "required": ["schema_version", "coverage_matrix", "validation_commands", "fixtures", "evidence_plan", "next_skill_handoff"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"type": "string"},
    "run_id": {"type": "string"},
    "project": {"type": "string"},
    "repository": {"type": "string"},
    "source_inputs": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "confidence": {"type": "string"},
    "blocking_gaps": {"type": "array", "items": {"type": "string"}},
    "next_skill_handoff": {"type": "object", "additionalProperties": true}
  }
}
