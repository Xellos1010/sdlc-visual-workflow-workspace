{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ADRRecord",
  "type": "object",
  "required": ["id", "title", "status", "context", "decision", "consequences"],
  "properties": {
    "id": {"type": "string"},
    "title": {"type": "string"},
    "status": {"enum": ["proposed", "accepted", "superseded", "rejected"]},
    "context": {"type": "string"},
    "options": {"type": "array"},
    "decision": {"type": "string"},
    "consequences": {"type": "array"},
    "reversalTriggers": {"type": "array"},
    "links": {"type": "array"}
  }
}
