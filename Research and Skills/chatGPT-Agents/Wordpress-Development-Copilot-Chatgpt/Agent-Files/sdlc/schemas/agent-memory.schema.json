{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Memory",
  "type": "object",
  "properties": {
    "durableFacts": { "type": "array", "items": { "type": "string" } },
    "acceptedDecisions": { "type": "array", "items": { "type": "object" } },
    "openQuestions": { "type": "array", "items": { "type": "object" } },
    "currentRunSummary": { "type": "string" },
    "handoffSummary": { "type": "string" },
    "lastAgentRunId": { "type": "string" },
    "lastEvidenceBundle": { "type": ["string", "null"] },
    "lastHumanDecisionIssue": { "type": ["string", "null"] }
  }
}
